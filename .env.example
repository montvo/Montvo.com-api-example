# Your SECRET key (sk_live_…), from Montvo → Developers.
# Server-side only. Never give it a NEXT_PUBLIC_ prefix: that would ship it to every browser.
MONTVO_SECRET_KEY=

# The short link your visitors go through. The Setup box on the home page shows
# which destination to give it (…/unlocked).
MONTVO_LINK=

# Optional. Only change this to point the app at a mock API while testing.
# MONTVO_API_BASE=https://montvo.com/api/v1